# ─────────────────────────────────────────────────────────────
# Easy Catalago — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env com credenciais reais.
# ─────────────────────────────────────────────────────────────

# ─── Aplicação ────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Banco de dados ───────────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://easycatalago:easycatalago@localhost:5433/easycatalago_dev"

# ─── Auth.js (next-auth) ──────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here-change-in-production"
AUTH_URL=http://localhost:3000

# ─── Storage de objetos (MinIO local / S3-compatível) ─────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=easycatalago
STORAGE_REGION=us-east-1
# Em produção: substitua pelo endpoint do S3 / Cloudflare R2
# STORAGE_ENDPOINT=https://your-r2-or-s3-endpoint

# ─── URL pública do storage (para servir imagens) ─────────────
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000/easycatalago
